rules_version = '2';

// ── Deployment ────────────────────────────────────────────────────────────────
// Firebase Console → Firestore → Rules → paste and Publish
// OR: firebase deploy --only firestore:rules  (requires firebase-tools)
//
// ── Server setup (one-time, before deploying these rules) ────────────────────
// 1. Firebase Console → Authentication → Add user
//    email: server@nxtwave.tech  (or any internal address)
//    password: <generate a strong password>
// 2. Firebase Console → Firestore → users collection → Add document
//    Document ID: <UID from step 1>
//    Fields: { email: "server@nxtwave.tech", displayName: "Automation Server",
//              role: "admin", status: "active" }
// 3. Render → Environment → Add vars:
//    SERVER_FB_EMAIL=server@nxtwave.tech
//    SERVER_FB_PASSWORD=<password from step 1>
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isAuth()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (userDoc().data.role == 'admin' || userDoc().data.role == 'super-admin')
        && userDoc().data.status == 'active';
    }

    function isActive() {
      return isAuth()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().data.status == 'active';
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Any auth user can read their own profile (needed for pending screen)
      allow read: if isAuth() && request.auth.uid == userId;
      // Admins can read all profiles
      allow read: if isAdmin();
      // Normal signup: pending status, no role
      allow create: if isAuth()
        && request.auth.uid == userId
        && request.resource.data.status == 'pending'
        && request.resource.data.role == null;
      // Pre-invited signup: active status allowed if invite exists for this email
      allow create: if isAuth()
        && request.auth.uid == userId
        && request.resource.data.status == 'active'
        && exists(/databases/$(database)/documents/invitedEmails/$(request.auth.token.email.lower()));
      // Only admins can approve, change roles, or revoke
      allow update, delete: if isAdmin();
    }

    // ── Pre-invited Emails ────────────────────────────────────────────────────
    match /invitedEmails/{email} {
      // Admins manage invites; users can read+delete their own invite on signup
      allow read: if isAdmin() || (isAuth() && request.auth.token.email.lower() == email);
      allow write: if isAdmin();
      allow delete: if isAuth() && request.auth.token.email.lower() == email;
    }

    // ── Roles ─────────────────────────────────────────────────────────────────
    match /roles/{roleId} {
      // All authenticated users read roles (AuthContext needs page access list)
      allow read: if isAuth();
      // Only admins create/update/delete roles
      allow write: if isAdmin();
    }

    // ── Data collections (assessments, bookings, sessions) ────────────────────
    match /assessments/{id}  { allow read, write: if isActive(); }
    match /bookingRows/{id}  { allow read, write: if isActive(); }
    match /examSessions/{id} { allow read, write: if isActive(); }
    match /config/{id}       { allow read, write: if isActive(); }
    match /jobLogs/{id}      { allow read, write: if isActive(); }

    // ── Automation settings (server URL, OTP, API keys) ───────────────────────
    match /settings/{id} {
      // Active users read (Create Assessments page loads server URL + credentials)
      allow read: if isActive();
      // Only admins write (sensitive credentials)
      allow write: if isAdmin();
    }

    // ── Interview Schedule ────────────────────────────────────────────────────
    match /scheduledInterviews/{id} {
      // Admins can read all and write (upload schedule)
      allow read, write: if isAdmin();
      // Interviewers can only read rows where panelistEmail matches their email
      allow read: if isActive()
        && resource.data.panelistEmail == request.auth.token.email.lower();
    }

    // ── Activity logs ─────────────────────────────────────────────────────────
    match /logs/{id} {
      allow create: if isActive();
      allow read:   if isAdmin();
    }
  }
}
