# Port the server listens on (Northflank injects this automatically)
PORT=3001

# Firebase Admin SDK — paste the full JSON of your service account key as one line
# Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"..."}

# Neon / Replit Postgres connection string for fetching contest bookings
CONTEST_BOOKINGS_DB_URL=postgresql://user:password@host/dbname

# Allowed frontend origin for CORS (your Vercel URL)
CLIENT_ORIGIN=https://your-app.vercel.app
