# Port the server listens on (Northflank injects this automatically)
PORT=3001

# Firebase Admin SDK — paste the full JSON of your service account key as one line
# Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"..."}

# Neon / Replit Postgres connection string for fetching contest bookings
CONTEST_BOOKINGS_DB_URL=postgresql://user:password@host/dbname

# Allowed frontend origin for CORS (your Vercel URL)
CLIENT_ORIGIN=https://your-app.vercel.app

# TinyURL API token — get from app.tinyurl.com/settings
TINYURL_API_TOKEN=your-tinyurl-api-token

# Interview Coordinator (IC) — external system that runs interviews.
# Confirmed live at this URL (verified 2026-08-20), but as of that check its
# /api/sync/completed-interviews endpoint has no ACADEMY_SYNC_API_TOKEN set
# on IC's side yet, so it 500s until someone with access to IC's Vercel
# project generates one (see api/sync/README.md "Setup" in that repo) and
# gives it to you.
INTERVIEW_COORDINATOR_API_URL=https://interview-coordinator.vercel.app

# Bearer token — must exactly match ACADEMY_SYNC_API_TOKEN set in IC's own
# Vercel env vars (that literal name; the endpoint isn't scoped per-consumer,
# so this same token works for any caller including this NIAT integration).
INTERVIEW_COORDINATOR_API_TOKEN=your-ic-sync-token

# Earliest date (YYYY-MM-DD) to pull on the very first sync, before any
# lastSyncTime watermark exists locally. Adjust once, then leave alone.
INTERVIEW_COORDINATOR_INITIAL_SYNC_FROM_DATE=2024-01-01
